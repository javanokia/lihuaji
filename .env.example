# Lihuaji Dual-Repository / Decoupled Assets Configuration
# Default: '.' (reads from local ./assets and ./content)
VITE_ASSETS_BASE_URL=.
VITE_DATA_BASE_URL=.

# When deploying with Scheme B (Decoupled Assets Repo):
# Set to your independent assets repository URL on GitHub Pages:
# VITE_ASSETS_BASE_URL=https://<your-username>.github.io/lihuaji-assets
# VITE_DATA_BASE_URL=https://<your-username>.github.io/lihuaji-assets
